
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Silver Love | Administração</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #fff4f8;
  color: #432735;
}

header {
  background: linear-gradient(135deg, #771b47, #c03977);
  color: white;
  padding: 24px 16px;
  text-align: center;
}

header h1 {
  margin: 0 0 8px;
  font-size: 25px;
}

header p {
  margin: 0;
}

main {
  max-width: 950px;
  margin: auto;
  padding: 16px;
}

.card {
  background: white;
  padding: 20px;
  margin: 16px 0;
  border-radius: 14px;
  box-shadow: 0 3px 14px #771b4717;
}

h2 {
  color: #8c2455;
  margin-top: 0;
}

label {
  display: block;
  margin: 12px 0 5px;
  font-weight: bold;
}

input,
textarea,
select {
  display: block;
  width: 100%;
  padding: 12px;
  border: 1px solid #dfbdcd;
  border-radius: 8px;
  font-size: 16px;
}

textarea {
  min-height: 85px;
}

button {
  background: #a82d65;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 12px 16px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
}

button:disabled {
  opacity: 0.5;
}

.secondary {
  background: #72616c;
}

.danger {
  background: #b92e49;
}

.hidden {
  display: none !important;
}

.actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 14px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(
    auto-fit,
    minmax(210px, 1fr)
  );
  gap: 12px;
}

.notice {
  padding: 14px;
  border-radius: 8px;
  margin-bottom: 14px;
  white-space: pre-wrap;
}

.product {
  padding: 15px 0;
  border-bottom: 1px solid #f0dce4;
}

.product:last-child {
  border-bottom: none;
}

.product-line {
  display: flex;
  align-items: center;
  gap: 12px;
}

.product-line img {
  width: 65px;
  height: 65px;
  object-fit: cover;
  border-radius: 8px;
}

.muted {
  color: #76636e;
  font-size: 13px;
  line-height: 1.6;
}

#logout {
  margin-top: 14px;
  background: white;
  color: #8c2455;
}

.checkline {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 15px;
}

.checkline input {
  width: auto;
}

.checkline label {
  margin: 0;
}
</style>
</head>

<body>

<header>
  <h1>💎 Silver Love</h1>
  <p>Painel Administrativo</p>

  <button id="logout" class="hidden">
    Sair
  </button>
</header>

<main>

<div id="message"
     class="notice hidden"
     role="status">
</div>

<section id="loginPanel" class="card">

  <h2>🔐 Acesso administrativo</h2>

  <form id="loginForm">

    <label for="email">E-mail</label>
    <input
      id="email"
      type="email"
      autocomplete="username"
      required
    >

    <label for="password">Senha</label>
    <input
      id="password"
      type="password"
      autocomplete="current-password"
      required
    >

    <div class="actions">
      <button id="loginButton" type="submit">
        Entrar
      </button>
    </div>

  </form>

</section>

<div id="dashboard" class="hidden">

  <section class="card">

    <h2 id="formTitle">➕ Cadastrar joia</h2>

    <form id="productForm">

      <input id="productId" type="hidden">

      <div class="grid">

        <div>
          <label for="codigo">Código</label>
          <input id="codigo" required>
        </div>

        <div>
          <label for="nome">Nome da joia</label>
          <input id="nome" required>
        </div>

        <div>
          <label for="preco">Preço (R$)</label>
          <input
            id="preco"
            type="number"
            min="0"
            step="0.01"
            required
          >
        </div>

        <div>
          <label for="estoque">Estoque</label>
          <input
            id="estoque"
            type="number"
            min="0"
            step="1"
            value="0"
            required
          >
        </div>

      </div>

      <label for="descricao">Descrição</label>
      <textarea id="descricao"></textarea>

      <label for="imagem_url">
        Caminho ou URL da foto
      </label>

      <input
        id="imagem_url"
        placeholder="fotos/108413.jpg"
      >

      <div class="checkline">
        <input
          id="ativo"
          type="checkbox"
          checked
        >
        <label for="ativo">
          Produto ativo
        </label>
      </div>

      <div class="actions">

        <button id="saveButton" type="submit">
          Salvar joia
        </button>

        <button
          id="cancelEdit"
          class="secondary"
          type="button">
          Limpar
        </button>

      </div>

    </form>

    <p class="muted">
      Por enquanto, utilize fotos já publicadas
      na pasta fotos do GitHub. O envio direto
      de imagens será adicionado depois.
    </p>

  </section>

  <section class="card">

    <h2>💍 Produtos cadastrados</h2>

    <button
      id="refreshProducts"
      class="secondary">
      Atualizar produtos
    </button>

    <div id="productsList">
      Carregando produtos...
    </div>

  </section>

  <section class="card">

    <h2>📋 Reservas</h2>

    <button
      id="refreshReservations"
      class="secondary">
      Atualizar reservas
    </button>

    <p class="muted">
      Aqui aparecem as reservas registradas
      no Supabase. Pedidos enviados somente
      pelo WhatsApp não aparecem automaticamente.
    </p>

    <div id="reservationsList">
      Carregando reservas...
    </div>

  </section>

</div>

</main>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>

<script>
"use strict";

// CONEXÃO COM SUPABASE

const SUPABASE_URL =
  "https://xyybmzfodlvwljhhfxhe.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_eoIGcXFPzWsdl9_qTUOeRw_uZoNx-80";

const SITE_URL =
  "https://douglascorce.github.io/silver-love/";

const db = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

const $ = id => document.getElementById(id);

// MENSAGENS

function showMessage(text, error = false) {
  const el = $("message");

  el.textContent = text;
  el.style.background = error
    ? "#ffe1e7"
    : "#e5f6e9";

  el.classList.remove("hidden");
}

function clearMessage() {
  $("message").classList.add("hidden");
}

function showDashboard(enabled) {
  $("dashboard").classList.toggle(
    "hidden",
    !enabled
  );

  $("loginPanel").classList.toggle(
    "hidden",
    enabled
  );

  $("logout").classList.toggle(
    "hidden",
    !enabled
  );
}

function money(value) {
  return Number(value || 0).toLocaleString(
    "pt-BR",
    {
      style: "currency",
      currency: "BRL"
    }
  );
}

function formatDate(value) {
  if (!value) return "—";

  return new Date(value).toLocaleString(
    "pt-BR"
  );
}

function errorText(error) {
  return error?.message || String(error);
}

function addText(parent, tag, value, className) {
  const element = document.createElement(tag);

  element.textContent = String(value ?? "");

  if (className) {
    element.className = className;
  }

  parent.appendChild(element);

  return element;
}

function imageAddress(path) {
  if (!path) return "";

  try {
    const url = new URL(path, SITE_URL);

    if (
      url.protocol === "https:" ||
      url.protocol === "http:"
    ) {
      return url.href;
    }
  } catch (error) {
    return "";
  }

  return "";
}

// VERIFICAR ADMINISTRADOR

async function isAdmin(user) {
  if (!user) return false;

  const { data, error } = await db
    .from("administradores")
    .select("id")
    .eq("id", user.id)
    .maybeSingle();

  if (error) throw error;

  return Boolean(data);
}

// VERIFICAR LOGIN

async function refreshAuth() {
  try {
    const { data, error } =
      await db.auth.getUser();

    const user = data?.user;

    if (error || !user) {
      showDashboard(false);
      return;
    }

    const allowed = await isAdmin(user);

    if (!allowed) {
      showDashboard(false);

      showMessage(
        "Usuário sem acesso administrativo. " +
        "Verifique as permissões RLS.",
        true
      );

      return;
    }

    showDashboard(true);

    await Promise.all([
      loadProducts(),
      loadReservations()
    ]);

  } catch (error) {
    showDashboard(false);

    showMessage(
      "Erro ao validar acesso: " +
      errorText(error),
      true
    );
  }
}

// ENTRAR

$("loginForm").addEventListener(
  "submit",
  async function(event) {
    event.preventDefault();

    clearMessage();

    $("loginButton").disabled = true;

    try {
      const email =
        $("email").value.trim();

      const password =
        $("password").value;

      const { error } =
        await db.auth.signInWithPassword({
          email,
          password
        });

      if (error) throw error;

      $("password").value = "";

      await refreshAuth();

    } catch (error) {
      showMessage(
        "Erro no login: " +
        errorText(error),
        true
      );
    } finally {
      $("loginButton").disabled = false;
    }
  }
);

// SAIR

$("logout").addEventListener(
  "click",
  async function() {
    await db.auth.signOut();

    showDashboard(false);
    clearMessage();
  }
);

// LIMPAR FORMULÁRIO

function resetForm() {
  $("productForm").reset();

  $("productId").value = "";
  $("estoque").value = "0";
  $("ativo").checked = true;

  $("formTitle").textContent =
    "➕ Cadastrar joia";

  $("saveButton").textContent =
    "Salvar joia";
}

$("cancelEdit").addEventListener(
  "click",
  resetForm
);

// SALVAR PRODUTO

$("productForm").addEventListener(
  "submit",
  async function(event) {
    event.preventDefault();

    clearMessage();

    $("saveButton").disabled = true;

    try {
      const item = {
        codigo: $("codigo").value.trim(),
        nome: $("nome").value.trim(),
        descricao:
          $("descricao").value.trim(),
        preco: Number($("preco").value),
        estoque: Number($("estoque").value),
        imagem_url:
          $("imagem_url").value.trim(),
        ativo: $("ativo").checked
      };

      if (
        !item.codigo ||
        !item.nome ||
        !Number.isFinite(item.preco) ||
        item.preco < 0 ||
        !Number.isInteger(item.estoque) ||
        item.estoque < 0
      ) {
        throw new Error(
          "Confira os dados da joia."
        );
      }

      const id = $("productId").value;

      let result;

      if (id) {
        result = await db
          .from("produtos")
          .update(item)
          .eq("id", id)
          .select("id");
      } else {
        result = await db
          .from("produtos")
          .insert(item)
          .select("id");
      }

      if (result.error) {
        throw result.error;
      }

      if (!result.data?.length) {
        throw new Error(
          "Nenhum registro alterado. " +
          "Confira as permissões RLS."
        );
      }

      resetForm();

      showMessage(
        "Joia salva com sucesso!"
      );

      await loadProducts();

    } catch (error) {
      showMessage(
        "Erro ao salvar: " +
        errorText(error),
        true
      );
    } finally {
      $("saveButton").disabled = false;
    }
  }
);

// CARREGAR PRODUTOS

async function loadProducts() {
  const list = $("productsList");

  list.textContent = "Carregando...";

  const { data, error } = await db
    .from("produtos")
    .select("*")
    .order("nome", {
      ascending: true
    });

  if (error) {
    list.textContent =
      "Erro: " + errorText(error);

    return;
  }

  list.replaceChildren();

  if (!data.length) {
    list.textContent =
      "Nenhum produto cadastrado.";

    return;
  }

  addText(
    list,
    "p",
    data.length + " produtos cadastrados.",
    "muted"
  );

  for (const item of data) {
    const card =
      document.createElement("div");

    card.className = "product";

    const line =
      document.createElement("div");

    line.className = "product-line";

    const src =
      imageAddress(item.imagem_url);

    if (src) {
      const img =
        document.createElement("img");

      img.src = src;
      img.alt = item.nome || "";
      img.loading = "lazy";

      line.appendChild(img);
    }

    const info =
      document.createElement("div");

    addText(
      info,
      "strong",
      item.nome
    );

    addText(
      info,
      "div",
      item.codigo +
      " | " +
      money(item.preco) +
      " | Estoque: " +
      item.estoque +
      " | " +
      (item.ativo ? "Ativo" : "Inativo"),
      "muted"
    );

    line.appendChild(info);
    card.appendChild(line);

    const actions =
      document.createElement("div");

    actions.className = "actions";

    // EDITAR

    const edit =
      document.createElement("button");

    edit.type = "button";
    edit.textContent = "Editar";

    edit.onclick = function() {
      const fields = [
        "codigo",
        "nome",
        "descricao",
        "preco",
        "estoque",
        "imagem_url"
      ];

      for (const field of fields) {
        $(field).value =
          item[field] ?? "";
      }

      $("ativo").checked =
        Boolean(item.ativo);

      $("productId").value =
        item.id;

      $("formTitle").textContent =
        "✏️ Editar joia";

      $("saveButton").textContent =
        "Salvar alterações";

      $("productForm").scrollIntoView({
        behavior: "smooth"
      });
    };

    actions.appendChild(edit);

    // EXCLUIR

    const remove =
      document.createElement("button");

    remove.type = "button";
    remove.className = "danger";
    remove.textContent = "Excluir";

    remove.onclick = async function() {
      const confirmed = confirm(
        'Excluir a joia "' +
        item.nome +
        '" permanentemente?'
      );

      if (!confirmed) return;

      const { data: deleted, error } =
        await db
          .from("produtos")
          .delete()
          .eq("id", item.id)
          .select("id");

      if (error || !deleted?.length) {
        showMessage(
          "Não foi possível excluir: " +
          errorText(
            error || "Permissão negada"
          ),
          true
        );

        return;
      }

      showMessage(
        "Produto excluído com sucesso."
      );

      await loadProducts();
    };

    actions.appendChild(remove);

    card.appendChild(actions);

    list.appendChild(card);
  }
}

$("refreshProducts").addEventListener(
  "click",
  loadProducts
);

// CARREGAR RESERVAS

async function loadReservations() {
  const list = $("reservationsList");

  list.textContent = "Carregando...";

  const { data, error } = await db
    .from("reservas")
    .select("*")
    .order("criado_em", {
      ascending: false
    })
    .limit(100);

  if (error) {
    list.textContent =
      "Erro ao carregar reservas: " +
      errorText(error);

    return;
  }

  list.replaceChildren();

  if (!data.length) {
    list.textContent =
      "Nenhuma reserva registrada no Supabase.";

    return;
  }

  for (const item of data) {
    const card =
      document.createElement("div");

    card.className = "product";

    addText(
      card,
      "strong",
      item.cliente_nome || "Cliente"
    );

    addText(
      card,
      "div",
      "WhatsApp: " +
      (item.cliente_whatsapp || "—") +
      " | Quantidade: " +
      (item.quantidade ?? "—") +
      " | Status: " +
      (item.status || "—"),
      "muted"
    );

    addText(
      card,
      "div",
      "Produto ID: " +
      (item.produto_id || "—") +
      " | " +
      formatDate(item.criado_em),
      "muted"
    );

    list.appendChild(card);
  }
}

$("refreshReservations").addEventListener(
  "click",
  loadReservations
);

// INICIAR

refreshAuth();

</script>

</body>
</html>
